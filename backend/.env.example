APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=physics_ai
SECRET_KEY=replace-with-a-long-random-value

# Server-only AI provider settings. Never use EXPO_PUBLIC_ for this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://physicsai.app
OPENROUTER_APP_NAME=Physics AI

FREE_CHAT_DAILY_LIMIT=3
BASIC_CHAT_DAILY_LIMIT=10
PRO_CHAT_DAILY_LIMIT=30
FREE_AI_GENERATION_DAILY_LIMIT=1
BASIC_AI_GENERATION_DAILY_LIMIT=5
PRO_AI_GENERATION_DAILY_LIMIT=15
